# CogniKeep が使うローカル LLM（llama.cpp サーバ）の接続先。
# 未設定の場合はこのファイルに書かれているデフォルト値が使われる。
#
# 前提: llama-server を OpenAI 互換モード（--jinja 等）で常駐起動しておくこと。
# テキスト推論用（カテゴリ体系のAI再設計・矛盾検知）、
# 画像理解用（スキャンPDFのAI変換フォールバック）、
# 埋め込み用（意味検索）で、それぞれ別サーバを想定している。

LLAMACPP_TEXT_URL=http://localhost:8080
LLAMACPP_TEXT_MODEL=gemma-4-12b-it-Q4_K_M.gguf

LLAMACPP_VISION_URL=http://localhost:8084
LLAMACPP_VISION_MODEL=Qwen3VL-8B-Instruct-Q4_K_M.gguf

LLAMACPP_EMBED_URL=http://localhost:8082
LLAMACPP_EMBED_MODEL=bbvch-ai/bge-m3-GGUF
LLAMACPP_EMBED_DIMS=1024
